---
// utils
import { currentYear } from "../../utils/currentYear";

// components
import Text from "../elements/Text.astro"
import Link from "../elements/Link.astro"

// change the name here
const {
    name = "Team Ward Labs"
} = Astro.props;
---

<footer class="flex flex-col gap-16 text-center text-base-600">
    <Text variant={'sm'}>{name} &copy; {currentYear()}</Text>
    <Text variant={'sm'}>Built with <Link variant={'inline'} href="https://astro.build" text="Astro" newWindow/> on the <Link variant={'inline'} href="https://github.com/jessgaspardev/decker" text="Decker" newWindow/> theme by Jess Gaspar</Text>
</footer>