{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "website",
  "compatibility_date": "2026-05-03",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
